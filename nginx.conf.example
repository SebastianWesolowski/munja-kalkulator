# ==============================================================================
# Przykładowa konfiguracja serwera Nginx dla Munja Kalkulator (Vite / dist)
# Zoptymalizowana pod kątem wydajności (Brotli / Gzip static, HTTP/2, Caching)
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name munja-kalkulator.wesolowski.dev;

    # Przekierowanie całego ruchu HTTP na HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name munja-kalkulator.wesolowski.dev;

    # Ścieżka do skompilowanego katalogu dist
    root /var/www/munja-kalkulator/dist;
    index index.html;

    # Certyfikaty SSL (np. Let's Encrypt / Certbot)
    # ssl_certificate /etc/letsencrypt/live/munja-kalkulator.wesolowski.dev/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/munja-kalkulator.wesolowski.dev/privkey.pem;

    # 1. Kompresja statyczna Gzip i Brotli (serwowanie gotowych plików .br / .gz wygenerowanych przez bundler)
    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        image/svg+xml;

    # Jeśli moduł ngx_brotli jest zainstalowany w Nginx:
    # brotli on;
    # brotli_static on;
    # brotli_comp_level 6;
    # brotli_types
    #     text/plain
    #     text/css
    #     text/javascript
    #     application/javascript
    #     application/json
    #     image/svg+xml;

    # 2. Długoterminowy cache (1 rok, immutable) dla zahashowanych zasobów JS/CSS/SVG
    location ^~ /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # 3. Główne zapytania i plik index.html (brak buforowania lub rewalidacja, aby natychmiast widzieć nowe wdrożenia)
    location / {
        add_header Cache-Control "public, max-age=0, must-revalidate";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

        try_files $uri $uri/ /index.html;
    }

    # 4. Blokada ukrytych plików (.git, .env itp.)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
